{
  "id": "./",
  "name": "Family Screen",
  "short_name": "Family",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#faf7f2",
  "theme_color": "#9fd8cf",
  "description": "Our family calendar, to-do list and shopping list — on the fridge and on our phones.",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "file",
          "accept": [
            "image/*",
            "application/pdf",
            "text/plain",
            "text/calendar",
            ".ics",
            ".eml",
            "message/rfc822"
          ]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "Add photos to the family album",
      "short_name": "Add photos",
      "url": "./?open=album",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Add anything",
      "short_name": "Add",
      "url": "./?open=addany",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Shopping list",
      "short_name": "Shopping",
      "url": "./?open=shop",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}
