rules_version = '2';
// Family Screen: only Google accounts listed in a household's "members" can read or change it.
// New families are invite-only: the admin invites a Google account, and only that account can set one up.
service cloud.firestore {
  match /databases/{database}/documents {
    function email() { return request.auth.token.email.lower(); }
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function isAdmin() { return signedIn() && email() == 'tonyandreynanz@gmail.com'; }
    function invited() { return signedIn() && exists(/databases/$(database)/documents/invites/$(email())); }
    function isMember(hid) { return signedIn() && email() in get(/databases/$(database)/documents/households/$(hid)).data.members; }

    match /invites/{inviteEmail} {
      allow read: if isAdmin() || (signedIn() && email() == inviteEmail);
      allow create, update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && email() == inviteEmail);
    }

    match /households/{hid} {
      allow read: if signedIn() && email() in resource.data.members;
      allow create: if (isAdmin() || invited())
                    && request.resource.data.members == [email()] && request.resource.data.owner == email();
      allow update: if isMember(hid)
                    && request.resource.data.owner == resource.data.owner
                    && request.resource.data.owner in request.resource.data.members
                    && request.resource.data.members.size() > 0 && request.resource.data.members.size() <= 12
                    && (request.resource.data.members.hasAll(resource.data.members) || email() == resource.data.owner);
      allow delete: if signedIn() && email() == resource.data.owner;

      match /{col}/{id} {
        allow read, write: if isMember(hid) && col in ['events', 'flights', 'groceries', 'todos', 'sources', 'recipes', 'meals', 'renewals'];
      }
      // Gift ideas: only the family members ticked in Settings (giftViewers) can read or change them
      match /gifts/{id} {
        allow read, write: if isMember(hid) && email() in get(/databases/$(database)/documents/households/$(hid)).data.get('giftViewers', []);
      }
      // Private entries: only the person they belong to can read or change them (not even other family members)
      match /private/{who}/{col}/{id} {
        allow read, write: if isMember(hid) && email() == who;
      }
    }
  }
}
