rules_version = '2';
// Family Screen: only Google accounts listed in a household's "members" can read or change it.
service cloud.firestore {
  match /databases/{database}/documents {
    function email() { return request.auth.token.email.lower(); }
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function isMember(hid) { return signedIn() && email() in get(/databases/$(database)/documents/households/$(hid)).data.members; }

    match /households/{hid} {
      allow read: if signedIn() && email() in resource.data.members;
      allow create: if signedIn() && request.resource.data.members == [email()] && request.resource.data.owner == email();
      allow update: if isMember(hid) && request.resource.data.owner == resource.data.owner
                    && request.resource.data.members.size() > 0 && request.resource.data.members.size() <= 12;
      allow delete: if false;

      match /{col}/{id} {
        allow read, write: if isMember(hid) && col in ['events', 'flights', 'groceries', 'todos', 'sources'];
      }
    }
  }
}
