rules_version = '2';
// Family Screen: only Google accounts listed in a household's "members" can read or change it.
// New families are invite-only: the admin invites a Google account, and only that account can set one up.
service cloud.firestore {
  match /databases/{database}/documents {
    function email() { return request.auth.token.email.lower(); }
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function isAdmin() { return signedIn() && email() == 'tonyandreynanz@gmail.com'; }
    function invited() { return signedIn() && exists(/databases/$(database)/documents/invites/$(email())); }
    // a calendar-only account that signs in with email and password may skip confirming its address (Tony's choice for
    // Masako); every other account must confirm it. Such an account still only gets the calendar.
    function okFor(d) { return request.auth != null && ((request.auth.token.email_verified == true && email() in d.members)
      || (request.auth.token.firebase.sign_in_provider == 'password' && email() in d.get('limited', []))); }
    function isMember(hid) { return okFor(get(/databases/$(database)/documents/households/$(hid)).data); }
    // calendar-only accounts (Settings → Family accounts): listed in the household's "limited"
    function isFull(hid) { return isMember(hid) && request.auth.token.email_verified == true && !(email() in get(/databases/$(database)/documents/households/$(hid)).data.get('limited', [])); }

    // 4.3 a messages-only account (Nana, Pop: listed in the household's "chatOnly") gets no calendar, flights or links
    function calOk(hid) { return isMember(hid) && !(email() in get(/databases/$(database)/documents/households/$(hid)).data.get('chatOnly', [])); }

    match /invites/{inviteEmail} {
      allow read: if isAdmin() || (signedIn() && email() == inviteEmail);
      allow create, update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && email() == inviteEmail);
    }

    match /households/{hid} {
      allow read: if okFor(resource.data);
      allow create: if (isAdmin() || invited())
                    && request.resource.data.members == [email()] && request.resource.data.owner == email();
      // a calendar-only account may only register its own phone for alerts and mark the calendar as changed
      allow update: if isMember(hid) && !isFull(hid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['devices', 'evAt']);
      allow update: if isFull(hid)
                    && (request.resource.data.get('limited', []) == resource.data.get('limited', []) || email() == resource.data.owner)
                    && request.resource.data.owner == resource.data.owner
                    && request.resource.data.owner in request.resource.data.members
                    && request.resource.data.members.size() > 0 && request.resource.data.members.size() <= 12
                    && (request.resource.data.members.hasAll(resource.data.members) || email() == resource.data.owner)
                    // who can see gift ideas may only be changed by someone already on that list (or the owner, or when the list is empty)
                    && (!('giftViewers' in request.resource.data) || request.resource.data.get('giftViewers', []) == resource.data.get('giftViewers', [])
                        || email() == resource.data.owner || resource.data.get('giftViewers', []).size() == 0 || email() in resource.data.get('giftViewers', []));
      allow delete: if signedIn() && email() == resource.data.owner;

      match /{col}/{id} {
        allow read: if calOk(hid) && col == 'events';
        allow write: if isMember(hid) && col == 'usage';
        // an account that only has a calendar link may add entries, and change or delete only the ones it added
        allow create: if calOk(hid) && col == 'events' && request.resource.data.by == email();
        allow update: if calOk(hid) && col == 'events' && resource.data.by == email() && request.resource.data.by == email();
        allow delete: if calOk(hid) && col == 'events' && resource.data.by == email();
        allow read: if calOk(hid) && col in ['flights', 'sources'];
        // 4.1 a linked account (another household's, e.g. Masako's) takes part only in the chats and calls that name it:
        // records carrying its address in "em". It reads nothing else here, can only tick "seen" on a message, and may
        // save and fetch a chat photo by its id (it cannot list them).
        allow read: if isMember(hid) && col in ['msgs', 'calls'] && email() in resource.data.em;
        allow create: if isMember(hid) && col in ['msgs', 'calls'] && email() in request.resource.data.em && request.resource.data.byE == email();
        allow update: if isMember(hid) && col == 'msgs' && email() in resource.data.em && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen']);
        allow update: if isMember(hid) && col == 'calls' && email() in resource.data.em && request.resource.data.em == resource.data.em;
        allow delete: if isMember(hid) && col == 'calls' && email() in resource.data.em && resource.data.byE == email();
        allow get, create: if isMember(hid) && col == 'msgpics';
        allow read, write: if isFull(hid) && col in ['events', 'flights', 'groceries', 'todos', 'sources', 'recipes', 'meals', 'renewals', 'bills', 'memory', 'kids', 'inbox', 'msgs', 'usage', 'docs', 'stock', 'calls', 'msgpics'];
      }
      // Secrets (the Gemini key): only signed-in family members can read or write them, so each family device can
      // talk to Gemini directly. Never on GitHub or the website.
      match /secrets/{id} {
        allow read, write: if isFull(hid);
      }
      // Gift ideas: only the family members ticked in Settings (giftViewers) can read or change them
      match /gifts/{id} {
        allow read, write: if isFull(hid) && email() in get(/databases/$(database)/documents/households/$(hid)).data.get('giftViewers', []);
      }
      // Private entries: only the person they belong to can read or change them (not even other family members)
      match /private/{who}/{col}/{id} {
        allow read, write: if isMember(hid) && email() == who;
      }
    }
  }
}
